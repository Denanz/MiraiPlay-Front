<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="РАСПИСАНИЕ · СЕГОДНЯ"
        android:textColor="#9B92AD"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Сегодня ничего не выходит"
        android:textColor="#9B92AD"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="5dp" android:paddingBottom="5dp">
        <ImageView android:id="@+id/thumb1" android:layout_width="28dp" android:layout_height="40dp"
            android:background="@drawable/widget_thumb_bg" android:scaleType="centerCrop" />
        <TextView android:id="@+id/title1" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="10dp" android:textColor="#F5F0FF" android:textSize="13sp"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/time1" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#C4A5FD" android:textSize="12sp" android:layout_marginStart="6dp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="5dp" android:paddingBottom="5dp">
        <ImageView android:id="@+id/thumb2" android:layout_width="28dp" android:layout_height="40dp"
            android:background="@drawable/widget_thumb_bg" android:scaleType="centerCrop" />
        <TextView android:id="@+id/title2" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="10dp" android:textColor="#F5F0FF" android:textSize="13sp"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/time2" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#C4A5FD" android:textSize="12sp" android:layout_marginStart="6dp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="5dp" android:paddingBottom="5dp">
        <ImageView android:id="@+id/thumb3" android:layout_width="28dp" android:layout_height="40dp"
            android:background="@drawable/widget_thumb_bg" android:scaleType="centerCrop" />
        <TextView android:id="@+id/title3" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="10dp" android:textColor="#F5F0FF" android:textSize="13sp"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/time3" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#C4A5FD" android:textSize="12sp" android:layout_marginStart="6dp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/row4" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="5dp" android:paddingBottom="5dp">
        <ImageView android:id="@+id/thumb4" android:layout_width="28dp" android:layout_height="40dp"
            android:background="@drawable/widget_thumb_bg" android:scaleType="centerCrop" />
        <TextView android:id="@+id/title4" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="10dp" android:textColor="#F5F0FF" android:textSize="13sp"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/time4" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#C4A5FD" android:textSize="12sp" android:layout_marginStart="6dp" />
    </LinearLayout>

</LinearLayout>
